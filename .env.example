# ── Database & Docker ─────────────────────────────────
MSSQL_SA_PASSWORD=YourStrong@Password123

# ── Backend Authentication & JWT ─────────────────────
JWT_KEY=your_64_char_random_secret_key_here_must_be_strong_and_long
JWT_ISSUER=WMS
JWT_AUDIENCE=WMS

# ── Third-Party Services ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

AI_PROVIDER_API_KEY=your_ai_provider_api_key

# ── Frontend (Vite) ──────────────────────────────────
# Browser API base URL. Use /api with Docker Compose/Nginx,
# or the public backend URL when frontend is deployed separately.
VITE_API_BASE_URL=http://localhost:5246/api

# Vite dev-server proxy target, used only by `npm run dev`.
VITE_DEV_API_PROXY_TARGET=http://localhost:5246

# ── Firebase Cloud Messaging (Web Push) ─────────────────────
# Backend Google Service Account:
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Frontend Firebase Web Push (Placeholder mẫu):
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key
