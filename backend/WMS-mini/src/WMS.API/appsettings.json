{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Pagination": {
    "PageSize": 10
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=WMS;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "AiProvider": {
    "ServiceUrl": "http://localhost:8000",
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "ApiKey": "",
    "Model": "gemini-1.5-flash"
  },
  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SenderEmail": "",
    "SenderName": "WMS Cloud Platform",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },
  "Frontend": {
    "Origin": "http://localhost:5173"
  }
}